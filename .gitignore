# Prebuilt binary -- the Docker image builds/pulls its own, this is just
# the local extracted release artifact.
/radio

# 918MB of GTASA audio + local transcode cache. Not needed by this
# station-controller image (see .dockerignore) and doesn't belong in git.
/data/audio/
/data/transcode-cache/

# Local reference copies used to pick correct logo filenames for the CDN
# (gta-tiles.upl.im) URLs baked into each station.json's logo_url -- never
# read by station.lua itself (which only ever uses the URL string), so
# these image files don't need to ship in the image or the repo.
/data/logos/

# Real JWT goes here, not in secret.example.yaml.
/k8s/secret.yaml
